# ─────────────────────────────────────────────────────────────────────────────
#  RABBIT HOLE — backend secrets. Paste keys after the = sign. No quotes.
#  This file stays on the server. It is NEVER sent to the browser, and users
#  never see which APIs or AI models are behind the app.
#
#  The app works with ZERO keys. Every key below is optional, 100% free,
#  and needs NO credit card.
# ─────────────────────────────────────────────────────────────────────────────


# ═══ AI MODELS ═══════════════════════════════════════════════════════════════
# Tried top-to-bottom (see LLM_ORDER). If one fails or hits its limit, the next
# one answers. Providers with no key are skipped. Pollinations needs no key and
# is always the last safety net.

# Groq — fastest. ~1,000 requests/day          → https://console.groq.com/keys
GROQ_API_KEY=
# Google Gemini — best synthesis, big context  → https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter — only its free ":free" models    → https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Cohere — free trial key                      → https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
# Z.ai — GLM Flash models are free             → https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=
# NVIDIA NIM — free prototyping endpoints      → https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=
# Hugging Face — small monthly free credit     → https://huggingface.co/settings/tokens
HF_TOKEN=
# Cloudflare Workers AI — 10k neurons/day      → https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Pollinations — works with NO key; a free key raises limits → https://enter.pollinations.ai
POLLINATIONS_API_KEY=
# Ollama — free local AI on your own PC (https://ollama.com). Set to 1 to use it.
OLLAMA_ENABLED=

# Fallback order. Leave as-is unless you want a different priority.
LLM_ORDER=groq,gemini,openrouter,cohere,zai,nvidia,huggingface,cloudflare,ollama,pollinations,pollinations-legacy
# Optional model override per provider: <ID>_MODEL=...  e.g. GROQ_MODEL=llama-3.3-70b-versatile
# (if a provider retires a model, the server picks a replacement automatically)


# ═══ WEB SEARCH ══════════════════════════════════════════════════════════════
# Without these, web search scrapes Brave/DuckDuckGo (works, but they rate-limit).
# Add either one for fast, reliable web + niche-site search.
# Tavily — 1,000 searches/month free          → https://app.tavily.com
TAVILY_API_KEY=
# Reserp (Google results) — 5,000 free searches a month → https://reserp.ai/dashboard/keys
RESERP_API_KEY=
# Serper (Google results) — 2,500 free          → https://serper.dev
SERPER_API_KEY=
# LangSearch — free daily allowance, no card    → https://langsearch.com
LANGSEARCH_API_KEY=
# Exa — $10 of searches free every month        → https://dashboard.exa.ai
EXA_API_KEY=
# SerpApi (Google results) — 250 a month free   → https://serpapi.com/users/sign_up
SERPAPI_API_KEY=
# Firecrawl search — 1,000 credits a month free, no card → https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=


# ═══ OPTIONAL SOURCE KEYS ════════════════════════════════════════════════════
# YouTube official search (otherwise scraped)  → https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=
# Reddit official API (otherwise the PullPush archive is used) → https://www.reddit.com/prefs/apps  (type: script)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Smithsonian via api.data.gov (otherwise DEMO_KEY) → https://api.data.gov/signup/
DATA_GOV_API_KEY=
# Europeana (otherwise shared demo key)        → https://pro.europeana.eu/page/get-api
EUROPEANA_API_KEY=
# OCCRP Aleph — leaks & investigations. Source stays hidden until set → https://aleph.occrp.org
ALEPH_API_KEY=
# Semantic Scholar — higher rate limit         → https://www.semanticscholar.org/product/api
S2_API_KEY=
# CourtListener — higher rate limit            → https://www.courtlistener.com/profile/api/
COURTLISTENER_TOKEN=
# GitHub — higher rate limit for code search   → https://github.com/settings/tokens
GITHUB_TOKEN=

# Your email, sent politely to OpenStreetMap / OpenAlex / SEC. Recommended.
CONTACT_EMAIL=


# ═══ ALREADY WORKING — NO KEY NEEDED ═════════════════════════════════════════
# These are fully open APIs. Nothing to paste; they're live right now:
#  Knowledge : Wikipedia, Wikidata, Wikimedia Commons, Wikiquote, Wiktionary,
#              Wikisource, Stanford Encyclopedia of Philosophy, Urban Dictionary
#  Archives  : Internet Archive, Wayback Machine, Open Library, Project Gutenberg,
#              Europeana, UK National Archives, declassified CIA/FBI/NSA files,
#              The Black Vault, MuckRock, DTIC, Cryptome
#  Museums   : Smithsonian, The Met, Art Institute of Chicago, Cleveland Museum,
#              V&A, Wellcome Collection
#  Academic  : OpenAlex, arXiv, Crossref, Europe PMC/PubMed, Semantic Scholar,
#              Zenodo, OEIS
#  Community : Reddit (PullPush archive), Hacker News, Lemmy, Stack Exchange
#  News      : Google News, GDELT
#  Media     : YouTube (+ transcripts), Dailymotion, Apple Podcasts, Openverse,
#              NASA Images, TVmaze, MusicBrainz
#  Weird     : Atlas Obscura, Lost Media Wiki, SCP Wiki, TV Tropes, RationalWiki,
#              Snopes, Know Your Meme, Websleuths/Doe Network, Fandom wikis,
#              Bellingcat, Damn Interesting, Futility Closet, Public Domain Review
#  Places    : OpenStreetMap (Nominatim + Photon), Wikipedia nearby, iNaturalist
#  Records   : CourtListener, Federal Register, SEC EDGAR
#  Web       : Brave, DuckDuckGo, Wiby (old web), GitHub


# ═══ SERVER ══════════════════════════════════════════════════════════════════
API_PORT=8787

# ── Sign-in for the online version (Supabase, free, no card) ──
# Leave these empty on your own computer (no sign-in there). On Vercel, set them:
# both values are public by design; the server checks every sign-in ticket.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional guest list: only these emails can use the site (comma-separated)
ALLOWED_EMAILS=
