{
  "name": "rabbit-hole",
  "private": true,
  "version": "0.1.0",
  "description": "Visual AI research board for falling down rabbit holes.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "node --watch-path=server --watch-path=shared --watch-path=.env --watch-preserve-output --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "vercel-build": "npm run build && node scripts/build-vercel.mjs",
    "typecheck": "tsc --noEmit",
    "check:ai": "tsx scripts/check-ai.ts",
    "check:sources": "tsx scripts/check-sources.ts",
    "check:keys": "tsx scripts/check-keys.ts",
    "check:health": "tsx scripts/check-health.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@mozilla/readability": "^0.6.0",
    "@supabase/supabase-js": "^2.117.2",
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.4",
    "fast-xml-parser": "^5.11.1",
    "hono": "^4.13.9",
    "html-to-image": "1.11.11",
    "idb-keyval": "^6.3.0",
    "jose": "^6.2.12",
    "jsdom": "^26.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "nanoid": "^6.0.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-force-graph-2d": "^1.29.1",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/nft": "^1.11.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
